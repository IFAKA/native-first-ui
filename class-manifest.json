{
  "name": "native-first-ui",
  "version": 1,
  "classes": [
    "nf-accordion",
    "nf-accordion-content",
    "nf-accordion-content-inner",
    "nf-accordion-item",
    "nf-accordion-trigger",
    "nf-alert",
    "nf-alert-demo",
    "nf-alert-description",
    "nf-alert-dialog",
    "nf-alert-dialog-footer",
    "nf-alert-dialog-header",
    "nf-alert-title",
    "nf-aspect-ratio",
    "nf-attachment-demo",
    "nf-avatar",
    "nf-avatar-demo",
    "nf-avatar-group",
    "nf-avatar-parity",
    "nf-avatar-parity-rounded",
    "nf-badge",
    "nf-badge-demo",
    "nf-badge-pill",
    "nf-brand",
    "nf-breadcrumb",
    "nf-card",
    "nf-carousel",
    "nf-carousel-next",
    "nf-carousel-track",
    "nf-chart",
    "nf-chart-bars",
    "nf-checkbox",
    "nf-cluster",
    "nf-command-demo",
    "nf-command-dialog",
    "nf-command-options",
    "nf-command-results",
    "nf-command-trigger",
    "nf-component-index",
    "nf-container",
    "nf-content",
    "nf-demo-separator",
    "nf-demo-shell",
    "nf-dismiss-after",
    "nf-empty",
    "nf-error",
    "nf-field",
    "nf-field-surface",
    "nf-form",
    "nf-grid",
    "nf-header-actions",
    "nf-help",
    "nf-hover-card",
    "nf-input-group",
    "nf-kbd-card",
    "nf-loading",
    "nf-mark-copy",
    "nf-menu-popover",
    "nf-menubar",
    "nf-message",
    "nf-message-body",
    "nf-navigation",
    "nf-otp",
    "nf-page",
    "nf-page-header",
    "nf-pagination",
    "nf-readable",
    "nf-resizable-grid",
    "nf-resizable-panel",
    "nf-scroll-area",
    "nf-section",
    "nf-shortcut",
    "nf-sidebar",
    "nf-skeleton",
    "nf-skip-link",
    "nf-spinner",
    "nf-split",
    "nf-sr-only",
    "nf-stack",
    "nf-table-scroll",
    "nf-tabs",
    "nf-theme-status",
    "nf-toggle",
    "nf-toggle-control",
    "nf-toggle-group-parity"
  ],
  "dataVariants": {
    "data-variant": [
      "primary",
      "danger",
      "quiet",
      "secondary",
      "outline",
      "ghost",
      "link"
    ],
    "data-tone": [
      "info",
      "success",
      "warning",
      "danger"
    ],
    "data-gap": [
      "sm",
      "lg"
    ],
    "data-size": [
      "short",
      "long"
    ],
    "data-theme": [
      "light",
      "dark"
    ]
  },
  "nativeSelectors": [
    "a",
    "article",
    "aside",
    "button",
    "details",
    "dialog",
    "fieldset",
    "form",
    "h1",
    "h2",
    "h3",
    "input",
    "label",
    "nav",
    "progress",
    "select",
    "summary",
    "table",
    "textarea"
  ],
  "contextualContracts": [
    {
      "name": "form-label-control",
      "selector": "form > label"
    },
    {
      "name": "navigation-links",
      "selector": "nav > a"
    },
    {
      "name": "fieldset-legend",
      "selector": "fieldset > legend"
    },
    {
      "name": "adjacent-help",
      "selector": "input + small, input + span"
    },
    {
      "name": "invalid-form",
      "selector": "form:has(:invalid)"
    },
    {
      "name": "grouped-controls",
      "selector": "[role=group] > :is(button, a)"
    }
  ],
  "tokens": {
    "prefix": "--nf-",
    "themeEscapeHatch": "Only --nf-* custom properties may be overridden by consumers."
  },
  "contracts": {
    "roleRepeating": "Classes may not name native roles (button, input, select, textarea, table, dialog, heading, link).",
    "arbitraryValues": "Utility values and inline style attributes are not part of the public API."
  }
}
