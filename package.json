{
  "name": "pith-css",
  "version": "0.1.0",
  "description": "Tiny, framework-agnostic CSS framework for semantic HTML and accessible responsive UI with zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/IFAKA/pith.git"
  },
  "bugs": {
    "url": "https://github.com/IFAKA/pith/issues"
  },
  "homepage": "https://ifaka.github.io/pith/",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "css",
    "accessibility",
    "a11y",
    "html",
    "design-system",
    "ui",
    "framework-agnostic",
    "native-first"
  ],
  "files": [
    "dist",
    "recipes",
    "README.md",
    "INTEGRATION-RULES.md",
    "docs",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/core.css",
    "./core.css": "./dist/core.css",
    "./layout.css": "./dist/layout.css",
    "./forms.css": "./dist/forms.css",
    "./navigation.css": "./dist/navigation.css",
    "./data.css": "./dist/data.css",
    "./overlays.css": "./dist/overlays.css",
    "./components.css": "./dist/components.css",
    "./behavior.js": "./dist/behavior.js"
  },
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "test": "npm run build:css && node scripts/audit-public-api.mjs && node scripts/validate-package.mjs && npm run size:check",
    "size:check": "node scripts/check-size.mjs",
    "pack:check": "npm pack --dry-run",
    "pages:build": "npm run build:css && node scripts/build-pages.mjs",
    "prepack": "npm run build:css",
    "serve": "node scripts/serve-example.mjs"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0"
  }
}
