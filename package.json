{
  "name": "native-first-ui",
  "version": "0.1.0",
  "description": "Accessible, framework-agnostic CSS contracts for native-first web interfaces.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/IFAKA/native-first-ui.git"
  },
  "bugs": {
    "url": "https://github.com/IFAKA/native-first-ui/issues"
  },
  "homepage": "https://ifaka.github.io/native-first-ui/",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "css",
    "accessibility",
    "a11y",
    "html",
    "design-system",
    "ui",
    "framework-agnostic",
    "native-first"
  ],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": "./dist/core.css",
    "./core.css": "./dist/core.css",
    "./tokens.css": "./dist/tokens.css",
    "./elements.css": "./dist/elements.css",
    "./patterns.css": "./dist/patterns.css",
    "./components.css": "./dist/components.css"
  },
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "test": "npm run build:css && node scripts/validate-package.mjs && npm run size:check",
    "size:check": "node scripts/check-size.mjs",
    "pack:check": "npm pack --dry-run",
    "pages:build": "npm run build:css && node scripts/build-pages.mjs",
    "prepack": "npm run build:css",
    "serve": "node scripts/serve-example.mjs",
    "setup:skills": "node scripts/install-skills.mjs"
  }
}
