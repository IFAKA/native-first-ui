  "sheet": "<div><button commandfor=\"component-sheet-demo\" command=\"show-modal\" data-variant=\"outline\">Open</button><dialog id=\"component-sheet-demo\" data-nf-drawer><form method=\"dialog\"><header><h2>Edit profile</h2><p>Make changes to your profile here. Click save when you&apos;re done.</p></header><div class=\"nf-grid nf-stack\"><div class=\"nf-grid nf-stack\"><label for=\"sheet-demo-name\">Name</label><input id=\"sheet-demo-name\" value=\"Pedro Duarte\" type=\"text\" /></div><div class=\"nf-grid nf-stack\"><label for=\"sheet-demo-username\">Username</label><input id=\"sheet-demo-username\" value=\"@peduarte\" type=\"text\" /></div></div><footer><button type=\"submit\">Save changes</button><button data-variant=\"outline\">Close</button></footer></dialog></div>",
