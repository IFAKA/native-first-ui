  "tabs": "<div class=\"nf-stack nf-content\"><section><div><button value=\"account\">Account</button><button value=\"password\">Password</button></div><div value=\"account\"><article><header><h3>Account</h3><p>Make changes to your account here. Click save when you&apos;re done.</p></header><div class=\"nf-grid nf-stack\"><div class=\"nf-grid nf-stack\"><label for=\"tabs-demo-name\">Name</label><input id=\"tabs-demo-name\" value=\"Pedro Duarte\" type=\"text\" /></div><div class=\"nf-grid nf-stack\"><label for=\"tabs-demo-username\">Username</label><input id=\"tabs-demo-username\" value=\"@peduarte\" type=\"text\" /></div></div><footer><button>Save changes</button></footer></article></div><div value=\"password\"><article><header><h3>Password</h3><p>Change your password here. After saving, you&apos;ll be logged out.</p></header><div class=\"nf-grid nf-stack\"><div class=\"nf-grid nf-stack\"><label for=\"tabs-demo-current\">Current password</label><input id=\"tabs-demo-current\" type=\"password\" /></div><div class=\"nf-grid nf-stack\"><label for=\"tabs-demo-new\">New password</label><input id=\"tabs-demo-new\" type=\"password\" /></div></div><footer><button>Save password</button></footer></article></div></section></div>",
